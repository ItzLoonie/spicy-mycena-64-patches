+
+// Maps a raw ASCII char to its dialog-font char code (see DialogSpecialChars /
+// ASCII_TO_DIALOG and charmap.txt). Case is preserved -- the dialog font has
+// full upper/lowercase coverage, unlike the options menu's item name encoding
+// this was originally modeled on, which only has an uppercase HUD font
+// available to it. Every character handled here has a real glyph in the
+// dialog font; only characters with no glyph at all (accents, etc.) fall back
+// to a space.
+// Note: charmap.txt aliases glyph 0xE4 to both '+' and '↔', but no vanilla
+// dialog text ever actually uses '+' -- the glyph itself is a two-way arrow,
+// not a plus sign. There's no real plus glyph in this font, so '+' is left
+// out here and falls back to a space like other no-glyph characters below,
+// rather than silently rendering as an arrow.
+static u8 SM64AP_DialogCharCode(char c) {
+    switch (c) {
+        case ' ':  return DIALOG_CHAR_SPACE;
+        case '-':  return SM64AP_DIALOG_CHAR_HYPHEN;
+        case '\'': return SM64AP_DIALOG_CHAR_APOSTROPHE;
+        case '.':  return DIALOG_CHAR_PERIOD;
+        case ',':  return DIALOG_CHAR_COMMA;
+        case '(':  return SM64AP_DIALOG_CHAR_OPEN_PAREN;
+        case ')':  return SM64AP_DIALOG_CHAR_CLOSE_PAREN;
+        case '&':  return SM64AP_DIALOG_CHAR_AMPERSAND;
+        case ':':  return SM64AP_DIALOG_CHAR_COLON;
+        case '!':  return SM64AP_DIALOG_CHAR_EXCLAIM;
+        case '%':  return SM64AP_DIALOG_CHAR_PERCENT;
+        case '?':  return SM64AP_DIALOG_CHAR_QUESTION;
+        case '~':  return SM64AP_DIALOG_CHAR_TILDE;
+        case '$':  return SM64AP_DIALOG_CHAR_DOLLAR;
+        default:
+            if ((c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')) {
+                return static_cast<u8>(ASCII_TO_DIALOG(c));
+            }
+            return DIALOG_CHAR_SPACE;
