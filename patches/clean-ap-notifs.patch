+// Draws one already-wrapped line at the given row, coloring whatever part of
+// each span falls on this line and leaving the rest white. spans must be
+// sorted by start and non-overlapping (true of everything SM64AP_PrintNext()
+// builds); handles zero, one, or several spans touching a given line.
+static void SM64AP_DrawWrappedNotifLine(s16 x, s16 y, const SM64AP_DialogLine &line, const std::vector<SM64AP_ColorSpan> &spans) {
+    static constexpr SM64AP_Color kWhite = { 255, 255, 255 };
+    size_t lineStart = line.startOffset;
+    size_t lineEnd = line.startOffset + line.text.size();
+
+    s16 curX = x;
+    size_t cursor = lineStart; // next undrawn character, in sentence offsets
+
+    auto drawPart = [&](size_t partStart, size_t partEnd, SM64AP_Color color) {
+        if (partEnd <= partStart) return;
+        std::string part = line.text.substr(partStart - lineStart, partEnd - partStart);
+        u8 encoded[64];
+        SM64AP_EncodeAsciiForDialog(part, encoded, sizeof(encoded));
+        SM64AP_DrawSimpleNotifLine(curX, y, encoded, color);
+        s32 widthPx = 0;
+        for (char c : part) widthPx += gDialogCharWidths[SM64AP_DialogCharCode(c)];
+        curX = static_cast<s16>(curX + widthPx);
+    };
+
+    for (const SM64AP_ColorSpan &span : spans) {
+        size_t spanBegin = std::max(span.start, lineStart);
+        size_t spanEndClipped = std::min(span.end, lineEnd);
+        if (spanBegin >= spanEndClipped) continue; // doesn't touch this line
+        if (spanBegin > cursor) {
+            drawPart(cursor, spanBegin, kWhite);
+            cursor = spanBegin;
+        }
+        drawPart(cursor, spanEndClipped, span.color);
+        cursor = spanEndClipped;
+    }
+    if (cursor < lineEnd) {
+        drawPart(cursor, lineEnd, kWhite);
+    }
+}
