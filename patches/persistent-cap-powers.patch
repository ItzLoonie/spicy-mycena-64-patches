  *                  INITIALIZATION                *
  **************************************************/
 
+/**
+ * Persistent cap powers: normally init_mario() would wipe out any active
+ * Metal/Wing/Vanish Cap and its timer on every respawn, including simple
+ * area transitions, warps, and Exit Course. Set this flag (via
+ * mario_clear_cap_power_on_next_spawn()) right before a respawn that should
+ * still wipe the cap power, i.e. dying. It's consumed and reset the next
+ * time init_mario() runs.
+ */
+static u32 sMarioClearCapPowerOnSpawn = FALSE;
+
+void mario_clear_cap_power_on_next_spawn(void) {
+    sMarioClearCapPowerOnSpawn = TRUE;
+}
+
 void init_mario(void) {
     Vec3s capPos;
     struct Object *capObject;
+    u32 prevCapPowerFlags = gMarioState->flags & (MARIO_VANISH_CAP | MARIO_METAL_CAP | MARIO_WING_CAP);
+    u16 prevCapTimer = gMarioState->capTimer;
+    u32 clearCapPower = sMarioClearCapPowerOnSpawn;
+
+    sMarioClearCapPowerOnSpawn = FALSE;
 
     unused80339F10 = 0;
 
@@ -1934,13 +1964,22 @@
         gMarioState->flags = (MARIO_CAP_ON_HEAD | MARIO_NORMAL_CAP);
     }
 
+    // Carry the active cap power (and its remaining timer) over from before
+    // this spawn, as long as we're not deliberately clearing it (death) and
+    // Mario is still wearing some cap at all (not stolen, hat item owned).
+    if (!clearCapPower && (gMarioState->flags & MARIO_CAP_ON_HEAD) && prevCapTimer > 0) {
+        gMarioState->flags |= prevCapPowerFlags;
+    } else {
+        prevCapTimer = 0;
+    }
+
     gMarioState->forwardVel = 0.0f;
     gMarioState->squishTimer = 0;
 
     gMarioState->hurtCounter = 0;
     gMarioState->healCounter = 0;
 
-    gMarioState->capTimer = 0;
+    gMarioState->capTimer = prevCapTimer;
     gMarioState->quicksandDepth = 0.0f;
 
     gMarioState->heldObj = NULL;
