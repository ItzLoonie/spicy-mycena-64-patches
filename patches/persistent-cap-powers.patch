 /**
+ * Persistent cap powers: while Mario is in one of the Castle hub levels
+ * (inside, main map/grounds, or courtyard), the cap timer is paused so it
+ * never runs out just from wandering the hub between courses.
+ */
+static s32 mario_is_in_castle_hub(void) {
+    return (gCurrLevelNum == LEVEL_CASTLE || gCurrLevelNum == LEVEL_CASTLE_GROUNDS
+            || gCurrLevelNum == LEVEL_CASTLE_COURTYARD);
+}
