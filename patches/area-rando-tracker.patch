+static void render_pause_entrances_page_one(s16 x, s16 y) {
+    static const s16 columnOffset[] = { 0, 100, 200 };
+    enum {
+        PAUSE_ENTRANCE_ROW_COUNT = ARRAY_COUNT(sPauseEntranceRows),
+        PAUSE_ENTRANCE_COLUMN_COUNT = 3,
