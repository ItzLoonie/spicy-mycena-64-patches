+bool SM64AP_IsEntranceDiscovered(int sourceEntrance) {
+    for (int bit = 0; bit < static_cast<int>(ARRAY_COUNT(sm64_shuffled_entrance_ids)); bit++) {
+        if (sm64_shuffled_entrance_ids[bit] == sourceEntrance) {
+            return (sm64_discovered_entrances_mask & (1 << bit)) != 0;
+        }
+    }
+
+    // Entrances that aren't part of the shuffled pool (e.g. fixed vanilla
+    // connections) are always considered "discovered" for display purposes.
+    return true;
+}
+
+bool SM64AP_IsSubAreaEntranceDiscovered(int sourceId) {
+    if (sourceId <= 0 || sourceId >= 64) {
+        return true;
+    }
+
+    const bool high = sourceId >= 32;
+    const int bit = high ? sourceId - 32 : sourceId - 1;
+    return ((high ? sm64_discovered_subarea_entrances_high : sm64_discovered_subarea_entrances_low)
+        & (1 << bit)) != 0;
+}
+
+int SM64AP_GetEntranceDestinationEntrance(int sourceEntrance) {
+    return SM64AP_GetMappedEntrance(sourceEntrance);
+}
+
+int SM64AP_GetEntranceDestinationSubAreaKey(int sourceEntrance) {
+    auto it = map_sub_area_entrances.find(1000 + sourceEntrance);
+    if (it == map_sub_area_entrances.end()) {
+        return -1;
+    }
+    return it->second & 0x0FFFFFFF;
+}
+
+int SM64AP_GetSubAreaEntranceDestinationEntrance(int sourceId) {
+    auto it = map_sub_area_entrances.find(sourceId);
+    if (it == map_sub_area_entrances.end()) {
+        return SM64AP_ENTRANCE_ID(LEVEL_NONE, 0);
+    }
+    int level = (it->second >> 16) & 0xFF;
+    int variant = (it->second >> 24) & 0x0F;
+    return SM64AP_ENTRANCE_ID(level, variant);
+}
+
+int SM64AP_GetSubAreaEntranceDestinationKey(int sourceId) {
+    auto it = map_sub_area_entrances.find(sourceId);
+    if (it == map_sub_area_entrances.end()) {
+        return 0;
+    }
+    return it->second & 0x0FFFFFFF;
+}
