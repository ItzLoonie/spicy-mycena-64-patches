+    if (locked) {
+        gDPSetEnvColor(gDisplayListHead++, 120, 120, 120, gDialogTextAlpha);
+    } else {
+        gDPSetEnvColor(gDisplayListHead++, 255, 255, 255, gDialogTextAlpha);
+    }
+
+    print_generic_string(x, y, sourceLabel);
+    render_pause_entrance_arrow(arrowX, y);
+
+    if (!discovered) {
+        gDPSetEnvColor(gDisplayListHead++, 120, 120, 120, gDialogTextAlpha);
+    }
+    print_generic_string(destX, y, discovered ? destLabel : sPauseEntranceUndiscoveredLabel);
