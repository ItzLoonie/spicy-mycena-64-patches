+static bool pause_entrance_locked(s16 sourceEntranceId) {
+    bool locked = false;
+    s16 course = pause_entrance_course(sourceEntranceId);
+
+    if (course != COURSE_NONE) {
+        locked = !pause_entrance_have_course_unlock(sourceEntranceId, course);
+    }
+
+    switch (sourceEntranceId) {
+        case SM64AP_ENTRANCE_ID(LEVEL_BBH, 1):
+            return !SM64AP_HaveBBH();
+
+        case SM64AP_ENTRANCE_ID(LEVEL_BITDW, 1):
+            return locked || !SM64AP_HaveCastleKey(SM64AP_CASTLE_KEY_FIRST_FLOOR);
+
+        case SM64AP_ENTRANCE_ID(LEVEL_HMC, 1):
+        case SM64AP_ENTRANCE_ID(LEVEL_LLL, 1):
+        case SM64AP_ENTRANCE_ID(LEVEL_SSL, 1):
+            return locked || !SM64AP_HaveCastleKey(SM64AP_CASTLE_KEY_BASEMENT);
+
+        case SM64AP_ENTRANCE_ID(LEVEL_DDD, 1):
+            return locked || !SM64AP_HaveCastleKey(SM64AP_CASTLE_KEY_BASEMENT_STAR);
+
+        case SM64AP_ENTRANCE_ID(LEVEL_BITFS, 1):
+            return !SM64AP_HaveBITFS() || !SM64AP_HaveCastleKey(SM64AP_CASTLE_KEY_BASEMENT_STAR);
+
+        case SM64AP_ENTRANCE_ID(LEVEL_WDW, SM64AP_ENTRANCE_WDW_LOW):
+        case SM64AP_ENTRANCE_ID(LEVEL_WDW, SM64AP_ENTRANCE_WDW_MIDDLE):
+        case SM64AP_ENTRANCE_ID(LEVEL_WDW, SM64AP_ENTRANCE_WDW_HIGH):
+        case SM64AP_ENTRANCE_ID(LEVEL_THI, 1):
+        case SM64AP_ENTRANCE_ID(LEVEL_THI, 2):
+        case SM64AP_ENTRANCE_ID(LEVEL_SL, 1):
+        case SM64AP_ENTRANCE_ID(LEVEL_TTM, 1):
+            return locked || !SM64AP_HaveCastleKey(SM64AP_CASTLE_KEY_UPSTAIRS);
+
+        case SM64AP_ENTRANCE_ID(LEVEL_TTC, SM64AP_ENTRANCE_TTC_STOPPED):
+        case SM64AP_ENTRANCE_ID(LEVEL_TTC, SM64AP_ENTRANCE_TTC_SLOW):
+        case SM64AP_ENTRANCE_ID(LEVEL_TTC, SM64AP_ENTRANCE_TTC_RANDOM):
+        case SM64AP_ENTRANCE_ID(LEVEL_TTC, SM64AP_ENTRANCE_TTC_FAST):
+            return locked || !SM64AP_HaveCastleKey(SM64AP_CASTLE_KEY_50_STAR);
+
+        case SM64AP_ENTRANCE_ID(LEVEL_RR, 1):
+            return locked || !SM64AP_HaveCastleKey(SM64AP_CASTLE_KEY_50_STAR);
+
+        case SM64AP_ENTRANCE_ID(LEVEL_WMOTR, 1):
+            return locked || !SM64AP_HaveCastleKey(SM64AP_CASTLE_KEY_50_STAR);
+
+        case SM64AP_ENTRANCE_ID(LEVEL_BITS, 1):
+            return !SM64AP_HaveCastleKey(SM64AP_CASTLE_KEY_70_STAR);
+
+        case SM64AP_ENTRANCE_ID(LEVEL_SA, 1):
+            return !SM64AP_HavePainting(COURSE_SA);
+
+        case SM64AP_ENTRANCE_ID(LEVEL_TOTWC, 1):
+            return !SM64AP_HaveWingCapLight();
+
+        case SM64AP_ENTRANCE_ID(LEVEL_VCUTM, 1):
+            return !SM64AP_HaveVcutmEntrance();
+
+        case SM64AP_ENTRANCE_ID(LEVEL_PSS, 1):
+            return !SM64AP_HavePainting(COURSE_PSS);
+
+        case SM64AP_ENTRANCE_ID(LEVEL_COTMC, 1):
+            return !SM64AP_HavePainting(COURSE_COTMC);
+    }
+
+    // BOB, WF, JRB, CCM: no castle-key gate, just their own course unlock.
+    return locked;
+}
