+// basement-neighbor DDD which is), and the secret-star doors that were
+// already checking SM64AP_HavePainting() here aren't COURSE_ constants, so
+// they're left out of this table and keep their existing standalone checks.
+static s16 pause_entrance_course(s16 sourceEntranceId) {
+    switch (sourceEntranceId) {
+        case SM64AP_ENTRANCE_ID(LEVEL_BOB, 1): return COURSE_BOB;
+        case SM64AP_ENTRANCE_ID(LEVEL_WF, 1):  return COURSE_WF;
+        case SM64AP_ENTRANCE_ID(LEVEL_JRB, 1): return COURSE_JRB;
+        case SM64AP_ENTRANCE_ID(LEVEL_CCM, 1): return COURSE_CCM;
+        case SM64AP_ENTRANCE_ID(LEVEL_HMC, 1): return COURSE_HMC;
+        case SM64AP_ENTRANCE_ID(LEVEL_LLL, 1): return COURSE_LLL;
+        case SM64AP_ENTRANCE_ID(LEVEL_SSL, 1): return COURSE_SSL;
+        case SM64AP_ENTRANCE_ID(LEVEL_DDD, 1): return COURSE_DDD;
+        case SM64AP_ENTRANCE_ID(LEVEL_WDW, SM64AP_ENTRANCE_WDW_LOW):
+        case SM64AP_ENTRANCE_ID(LEVEL_WDW, SM64AP_ENTRANCE_WDW_MIDDLE):
+        case SM64AP_ENTRANCE_ID(LEVEL_WDW, SM64AP_ENTRANCE_WDW_HIGH):
+            return COURSE_WDW;
+        case SM64AP_ENTRANCE_ID(LEVEL_SL, 1):  return COURSE_SL;
+        case SM64AP_ENTRANCE_ID(LEVEL_TTM, 1): return COURSE_TTM;
+        case SM64AP_ENTRANCE_ID(LEVEL_THI, 1):
+        case SM64AP_ENTRANCE_ID(LEVEL_THI, 2):
+            return COURSE_THI;
+        case SM64AP_ENTRANCE_ID(LEVEL_TTC, SM64AP_ENTRANCE_TTC_STOPPED):
+        case SM64AP_ENTRANCE_ID(LEVEL_TTC, SM64AP_ENTRANCE_TTC_SLOW):
+        case SM64AP_ENTRANCE_ID(LEVEL_TTC, SM64AP_ENTRANCE_TTC_RANDOM):
+        case SM64AP_ENTRANCE_ID(LEVEL_TTC, SM64AP_ENTRANCE_TTC_FAST):
+            return COURSE_TTC;
+        case SM64AP_ENTRANCE_ID(LEVEL_RR, 1):    return COURSE_RR;
+        case SM64AP_ENTRANCE_ID(LEVEL_WMOTR, 1): return COURSE_WMOTR;
+    }
+
+    return COURSE_NONE;
+}
