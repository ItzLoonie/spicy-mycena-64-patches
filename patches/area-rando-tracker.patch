+#define SM64AP_SUBAREA_DEST_KEY(level, area, node) (((level) << 16) | ((area) << 8) | (node))
+
+static const u8 *pause_subarea_dest_label(int destKey) {
+    switch (destKey) {
+        case SM64AP_SUBAREA_DEST_KEY(LEVEL_CCM, 2, 0x0A): return sSubAreaCcmSlide;
+        case SM64AP_SUBAREA_DEST_KEY(LEVEL_SL,  2, 0x0A): return sSubAreaSlIgloo;
+        case SM64AP_SUBAREA_DEST_KEY(LEVEL_TTM, 2, 0x0A): return sSubAreaTtmSlide;
+        case SM64AP_SUBAREA_DEST_KEY(LEVEL_THI, 3, 0x0A): return sSubAreaThiRedCave;
+        case SM64AP_SUBAREA_DEST_KEY(LEVEL_JRB, 2, 0x0A): return sSubAreaJrbShip;
+        case SM64AP_SUBAREA_DEST_KEY(LEVEL_LLL, 2, 0x0A): return sSubAreaLllVolcano;
+        case SM64AP_SUBAREA_DEST_KEY(LEVEL_SSL, 2, 0x0A): return sSubAreaSslPyramidSide;
+        case SM64AP_SUBAREA_DEST_KEY(LEVEL_SSL, 2, 0x14): return sSubAreaSslPyramidTop;
+        case SM64AP_SUBAREA_DEST_KEY(LEVEL_THI, 3, 0x0B): return sSubAreaThiWiggler;
+        case SM64AP_SUBAREA_DEST_KEY(LEVEL_BOWSER_1, 1, 0x0A): return sSubAreaBitdwBowser;
+        case SM64AP_SUBAREA_DEST_KEY(LEVEL_BOWSER_2, 1, 0x0A): return sSubAreaBitfsBowser;
+        case SM64AP_SUBAREA_DEST_KEY(LEVEL_BOWSER_3, 1, 0x0A): return sSubAreaBitsBowser;
+        // Return/exit destinations back to a course's main area
+        case SM64AP_SUBAREA_DEST_KEY(LEVEL_CCM, 1, 0x14): return sSubAreaCcmSlideExit;
+        case SM64AP_SUBAREA_DEST_KEY(LEVEL_SL,  1, 0x0B): return sSubAreaSlIglooExit;
+        case SM64AP_SUBAREA_DEST_KEY(LEVEL_TTM, 1, 0x14): return sSubAreaTtmSlideExit;
+        case SM64AP_SUBAREA_DEST_KEY(LEVEL_THI, 1, 0x0B): return sSubAreaThiRedCaveExit;
+    }
+    // Single-area courses, Bowser arenas, and castle-grounds/lobby returns
+    // are already unambiguous at the course level.
+    //
+    // The variant to display isn't in a fixed bit position: per
+    // SM64AP_ApplySubAreaDestination(), WDW/TTC pack their shuffle-able
+    // variant (water height / clock-arm speed) in bits 24-27, since those
+    // aren't physical areas at all - TTC only has one area, and WDW's three
+    // water heights map onto just two areas. Every other multi-destination
+    // course (THI Huge/Tiny) has no such variant field (it reads back as 0
+    // here), and instead differs by physical area, in bits 8-15.
+    int level = (destKey >> 16) & 0xFF;
+    int variantField = (destKey >> 24) & 0x0F;
+    int area = (destKey >> 8) & 0xFF;
+    int variant = ((level == LEVEL_WDW || level == LEVEL_TTC) && variantField != 0)
+        ? variantField
+        : area;
+    return pause_entrance_dest_label(SM64AP_ENTRANCE_ID(level, variant));
+}
