+// Maps a destination LEVEL_ constant to the same short label already used
+// elsewhere in this file for that course, for "SRC > DEST" display.
+static const u8 *pause_entrance_dest_label(s16 entranceKey) {
+    switch (entranceKey) {
+        case SM64AP_ENTRANCE_ID(LEVEL_WDW, SM64AP_ENTRANCE_WDW_LOW):    return sPauseEntranceWdwLow;
+        case SM64AP_ENTRANCE_ID(LEVEL_WDW, SM64AP_ENTRANCE_WDW_MIDDLE): return sPauseEntranceWdwMiddle;
+        case SM64AP_ENTRANCE_ID(LEVEL_WDW, SM64AP_ENTRANCE_WDW_HIGH):   return sPauseEntranceWdwHigh;
+        case SM64AP_ENTRANCE_ID(LEVEL_TTC, SM64AP_ENTRANCE_TTC_STOPPED): return sPauseEntranceTtcStopped;
+        case SM64AP_ENTRANCE_ID(LEVEL_TTC, SM64AP_ENTRANCE_TTC_SLOW):    return sPauseEntranceTtcSlow;
+        case SM64AP_ENTRANCE_ID(LEVEL_TTC, SM64AP_ENTRANCE_TTC_RANDOM):  return sPauseEntranceTtcRandom;
+        case SM64AP_ENTRANCE_ID(LEVEL_TTC, SM64AP_ENTRANCE_TTC_FAST):    return sPauseEntranceTtcFast;
+        case SM64AP_ENTRANCE_ID(LEVEL_THI, 1): return sPaintingThiHuge;
+        case SM64AP_ENTRANCE_ID(LEVEL_THI, 2): return sPaintingThiTiny;
+    }
+
+    switch (entranceKey / 10) {
+        case LEVEL_BOB:    return sPaintingBob;
+        case LEVEL_WF:     return sPaintingWf;
+        case LEVEL_JRB:    return sPaintingJrb;
+        case LEVEL_CCM:    return sPaintingCcm;
+        case LEVEL_BBH:    return sPaintingBbh;
+        case LEVEL_HMC:    return sPaintingHmc;
+        case LEVEL_LLL:    return sPaintingLll;
+        case LEVEL_SSL:    return sPaintingSsl;
+        case LEVEL_DDD:    return sPaintingDdd;
+        case LEVEL_SL:     return sPaintingSl;
+        case LEVEL_WDW:    return sPaintingWdw;
+        case LEVEL_TTM:    return sPaintingTtm;
+        case LEVEL_THI:    return sPaintingThiHuge;
+        case LEVEL_TTC:    return sPaintingTtc;
+        case LEVEL_RR:     return sPaintingRr;
+        case LEVEL_WMOTR:  return sPaintingWmotr;
+        case LEVEL_BITDW:  return sPauseEntranceBitdw;
+        case LEVEL_BITFS:  return sPauseEntranceBitfs;
+        case LEVEL_BITS:   return sPauseEntranceBits;
+        case LEVEL_BOWSER_1: return sPauseEntranceBitdw;
+        case LEVEL_BOWSER_2: return sPauseEntranceBitfs;
+        case LEVEL_BOWSER_3: return sPauseEntranceBits;
+        case LEVEL_VCUTM:  return sPauseEntranceVcutm;
+        case LEVEL_COTMC:  return sPauseViewCotmc;
+        case LEVEL_TOTWC:  return sPauseEntranceTotwc;
+        case LEVEL_PSS:    return sPauseViewPss;
+        case LEVEL_SA:     return sPauseViewSa;
+        case LEVEL_CASTLE:
+        case LEVEL_CASTLE_GROUNDS:
+        case LEVEL_CASTLE_COURTYARD:
+            return sPauseEntranceCastle;
+        default:           return sPauseEntranceUndiscoveredLabel;
+    }
+}
