+static void render_pause_entrance_row(s16 x, s16 y, const u8 *sourceLabel, const u8 *destLabel,
+                                       bool discovered, bool locked) {
+    // Fixed offsets don't work here: label widths vary a lot ("SL" is 11px,
+    // "TTC RND" is 43px), so a gap sized for the short ones clips the long
+    // ones. Measure the actual source label and place the arrow/dest text
+    // right after it instead.
+    s16 sourceWidth = get_string_width((u8 *) sourceLabel);
+    s16 arrowX = x + sourceWidth + 4;
+    s16 destX = arrowX + 10;
