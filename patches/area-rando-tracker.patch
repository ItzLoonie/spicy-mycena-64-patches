+static bool pause_entrance_have_course_unlock(s16 sourceEntranceId, s16 course) {
+    if (course == COURSE_THI) {
+        return SM64AP_HavePaintingForArea(course, sourceEntranceId % 10);
+    }
+    return SM64AP_HavePainting(course);
+}
