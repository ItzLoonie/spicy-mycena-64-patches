+// Draws the ">" separator between a source and destination label. Reuses
+// the same right-pointing triangle display list already used elsewhere in
+// this file as the menu cursor/selection arrow.
+static void render_pause_entrance_arrow(s16 x, s16 y) {
+    create_dl_translation_matrix(MENU_MTX_PUSH, x, y, 0);
+    gSPDisplayList(gDisplayListHead++, dl_draw_triangle);
+    gSPPopMatrix(gDisplayListHead++, G_MTX_MODELVIEW);
+
+    // dl_draw_triangle is designed to be used standalone: it exits by
+    // restoring the lit/opaque/untextured-SHADE 3D pipeline state, which is
+    // correct everywhere else it's used (cursor arrows, cannon reticle),
+    // but wrong here since we're still inside a dl_ia_text_begin/
+    // dl_ia_text_end block with more text left to print. Left uncorrected,
+    // every print_generic_string() call after the first arrow draws with
+    // lighting back on, no texture, and opaque z-buffered blending -
+    // producing the garbled solid-triangle blocks instead of characters.
+    // Undo exactly what its exit code changed, without touching env color
+    // (render_pause_entrance_row relies on that being left alone).
+    gSPClearGeometryMode(gDisplayListHead++, G_LIGHTING);
+    gDPSetCombineMode(gDisplayListHead++, G_CC_FADEA, G_CC_FADEA);
+    gDPSetRenderMode(gDisplayListHead++, G_RM_XLU_SURF, G_RM_XLU_SURF2);
+    gDPSetTextureFilter(gDisplayListHead++, G_TF_POINT);
+}
