+) {
+    static const u8 label[] = {
+        ASCII_TO_DIALOG('B'), ASCII_TO_DIALOG('O'), ASCII_TO_DIALOG('W'), ASCII_TO_DIALOG('S'),
+        ASCII_TO_DIALOG('E'), ASCII_TO_DIALOG('R'), DIALOG_CHAR_SPACE,
