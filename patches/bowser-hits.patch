+        DIALOG_CHAR_SPACE,
+        ASCII_TO_DIALOG('H'), ASCII_TO_DIALOG('I'), ASCII_TO_DIALOG('T'), ASCII_TO_DIALOG('S'),
+        DIALOG_CHAR_TERMINATOR
+    };
+    u8 value[4];
+    s16 collapseHits;
+
+    if (levelNum != LEVEL_BITS || row >= maxRows) {
+        return 0;
+    }
+    collapseHits = SM64AP_BowserInTheSkyStageCollapseHits();
+    if (collapseHits < 0) {
+        return 0;
+    }
+    int_to_str(collapseHits, value);
+    print_generic_string(x, y - row * 11, label);
+    print_generic_string(valueX, y - row * 11, value);
+    return 1;
+}
