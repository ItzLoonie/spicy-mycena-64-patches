+// instrument is picked per bank/instrument pair once per area load.
+static std::map<int,int> sm64_instrument_random_cache;
+// Separate cache for the "misc music" sequence player (SEQ_PLAYER_ENV), e.g.
+// the puzzle/key jingle -- kept independent of level music in case it
+// doesn't feel like "music" to the player.
+static std::map<int,int> sm64_jingle_instrument_random_cache;
+// Separate cache for the SFX sequence player (SEQ_PLAYER_SFX), so that
+// shuffling music instruments doesn't also shuffle sound effect timbres
+// (and vice versa) unless the player explicitly turns both on.
+static std::map<int,int> sm64_sfx_instrument_random_cache;
 std::map<int,int> map_start_inventory;
 int sm64_coin_star_requirements[15] = {
     100, 100, 100, 100, 100,
@@ -235,6 +249,12 @@ static constexpr int SM64AP_MUSIC_SHUFFLE_RANDOM_ON_LOAD = 2;
 static constexpr int SM64AP_SKYBOX_SHUFFLE_OFF = 0;
 static constexpr int SM64AP_SKYBOX_SHUFFLE_MAP = 1;
 static constexpr int SM64AP_SKYBOX_SHUFFLE_RANDOM_ON_LOAD = 2;
+// Mirrors SEQ_PLAYER_LEVEL/SEQ_PLAYER_ENV/SEQ_PLAYER_SFX from
+// src/audio/external.h (not included here to avoid pulling audio-internal
+// headers into this file). Keep these in sync if those ever change.
+static constexpr u8 SM64AP_SEQ_PLAYER_LEVEL = 0;
+static constexpr u8 SM64AP_SEQ_PLAYER_ENV = 1;
+static constexpr u8 SM64AP_SEQ_PLAYER_SFX = 2;
 static constexpr int SM64AP_NUM_COIN_STAR_REQUIREMENTS = 15;
 static constexpr int SM64AP_NUM_COIN_CHECK_COURSES = 24;
 static constexpr int SM64AP_DEFAULT_COIN_STAR_REQUIREMENT = 100;
@@ -3533,6 +3553,58 @@ s16 SM64AP_ResolveSkyboxBackground(s16 vanillaSkybox) {
     return sm64_loaded_skybox >= 0 ? static_cast<s16>(sm64_loaded_skybox) : vanillaSkybox;
 }
 
+void SM64AP_ReshuffleInstruments() {
+    // Clears the per-area "Random On Load" caches (music, jingles, and SFX
+    // each kept separately). The next time each (bank, instrument) pair is
+    // queried via SM64AP_ResolveInstrument, a fresh random substitute will
+    // be chosen and cached for the rest of the area, mirroring
+    // SM64AP_SelectSkybox's "Random On Load" behavior.
+    sm64_instrument_random_cache.clear();
+    sm64_jingle_instrument_random_cache.clear();
+    sm64_sfx_instrument_random_cache.clear();
+}
+
+u8 SM64AP_ResolveInstrument(u8 bankId, u8 instId, u8 numInstruments, u8 seqPlayerIdx) {
+    if (numInstruments == 0) {
+        return instId;
+    }
+
+    bool shuffleEnabled;
+    std::map<int,int> *randomCache;
+
+    switch (seqPlayerIdx) {
+        case SM64AP_SEQ_PLAYER_ENV:
+            shuffleEnabled = configJingleInstrumentShuffleMode;
+            randomCache = &sm64_jingle_instrument_random_cache;
+            break;
+
+        case SM64AP_SEQ_PLAYER_SFX:
+            shuffleEnabled = configSfxInstrumentShuffleMode;
+            randomCache = &sm64_sfx_instrument_random_cache;
+            break;
+
+        case SM64AP_SEQ_PLAYER_LEVEL:
+        default:
+            shuffleEnabled = configInstrumentShuffleMode;
+            randomCache = &sm64_instrument_random_cache;
+            break;
+    }
+
+    if (!shuffleEnabled) {
+        return instId;
+    }
+
+    int key = (static_cast<int>(bankId) << 8) | instId;
+    auto entry = randomCache->find(key);
+    if (entry != randomCache->end()
+        && entry->second >= 0 && entry->second < numInstruments) {
+        return static_cast<u8>(entry->second);
+    }
+    u8 randomInstId = static_cast<u8>(random_u16() % numInstruments);
+    (*randomCache)[key] = randomInstId;
+    return randomInstId;
+}
+
 bool SM64AP_HaveKey1() {
     return SM64AP_HaveCastleKey(SM64AP_CASTLE_KEY_BASEMENT);
 }
