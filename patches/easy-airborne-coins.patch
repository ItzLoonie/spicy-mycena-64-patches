+/**
+ * Extra pickup radius applied only when Mario is actively airbone
+ * when flying with the Wing Cap or being launched from a Cannon.
+ */
+#define AIRBORNE_PICKUP_RADIUS_BONUS 150.0f
+
+/**
+ * Returns the extra collision radius to grant this Mario/object pair, or
+ * 0 if the bonus doesn't apply (not flying, or not a coin/hidden star
+ * trigger).
+ */
+static f32 get_airborne_pickup_bonus(struct Object *a, struct Object *b) {
+    struct Object *other;
+
+    if (a == gMarioObject) {
+        other = b;
+    } else if (b == gMarioObject) {
+        other = a;
+    } else {
+        return 0.0f;
+    }
+
+    if (gMarioState == NULL) {
+    return 0.0f;
+	}
+
+	if (gMarioState->action != ACT_FLYING && gMarioState->action != ACT_SHOT_FROM_CANNON) {
+		return 0.0f;
+	}
+
+    if ((other->oInteractType & INTERACT_COIN)
+        || other->behavior == segmented_to_virtual(bhvHiddenStarTrigger)) {
+        return AIRBORNE_PICKUP_RADIUS_BONUS;
+    }
+
+    return 0.0f;
+}
